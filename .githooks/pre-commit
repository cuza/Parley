#!/bin/sh
# Formats the Swift files this commit adds or changes with swift-format (.swift-format), then lints them with SwiftLint
# (.swiftlint.yml): lint errors stop the commit, warnings are listed. Turn it on once per clone:
# git config core.hooksPath .githooks
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.swift' | grep -v '/Proto/')   # Proto/: generated by protoc
[ -n "$files" ] || exit 0

if xcrun --find swift-format >/dev/null 2>&1; then
    unformatted=""
    for file in $files; do
        if git diff --quiet -- "$file"; then
            # Staged as a whole: format it and stage the result.
            xcrun swift-format format -i "$file" && git add "$file"
        else
            # Only partly staged: reformatting would stage the rest too, so check the staged text instead.
            staged=$(git show ":$file")
            [ "$(printf '%s\n' "$staged" | xcrun swift-format format --assume-filename "$file" -)" = "$staged" ] \
                || unformatted="$unformatted $file"
        fi
    done
    if [ -n "$unformatted" ]; then
        echo "pre-commit: these partly staged files aren't formatted; run xcrun swift-format format -i on them:$unformatted"
        exit 1
    fi
else
    echo "pre-commit: swift-format isn't available (it comes with Xcode); not formatting."
fi

command -v swiftlint >/dev/null 2>&1 || { echo "pre-commit: SwiftLint isn't installed (brew install swiftlint); not linting."; exit 0; }
# shellcheck disable=SC2086 # one path per word; the repo's paths have no spaces
swiftlint lint --quiet --force-exclude $files || { echo "pre-commit: fix the SwiftLint errors above, then commit again."; exit 1; }
